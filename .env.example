# ATS Core environment variables (copy to .env)

# Режим: 1 = stub (in-memory + stub-AI, без БД/LLM), 0 = реальные адаптеры
ATS_STUB_MODE=1

# --- AI: Cloud.ru (OpenAI-совместимый провайдер) ---
# base_url Cloud.ru LLM API (получить в личном кабинете Cloud.ru)
ATS_AI_CLOUDRU_API_BASE=https://llm.api.cloud.ru/v1
# API-ключ Cloud.ru (НИКОГДА не коммитить реальный ключ!)
ATS_AI_CLOUDRU_API_KEY=
# Модели Cloud.ru (префикс openai/ → LiteLLM OpenAI-совместимый роутинг)
ATS_AI_DEFAULT_MODEL=openai/gpt-4o-mini
ATS_AI_FALLBACK_MODEL=openai/gpt-4o-mini
# Эмбеддинги 4096 (text-embedding-3-large — фиксированное решение проекта)
ATS_AI_EMBEDDING_MODEL=openai/text-embedding-3-large
ATS_AI_EMBEDDING_DIMENSION=4096
ATS_AI_EMBEDDING_MAX_TOKENS=8000

# --- AI: кэш, retry, бюджеты ---
ATS_AI_CACHE_ENABLED=true
ATS_AI_CACHE_TTL_SECONDS=86400
ATS_AI_MAX_RETRIES=3
ATS_AI_TIMEOUT_SECONDS=30
ATS_AI_MAX_TOKENS_PER_REQUEST=4096
ATS_AI_ENABLE_NON_AI_FALLBACK=true

# --- Legacy OpenAI (опциональный fallback на другой провайдер) ---
ATS_AI_OPENAI_API_KEY=

# --- Database (prod mode) ---
ATS_DB_URL=postgresql+asyncpg://ats:ats@localhost:5433/ats

# --- Redis (prod mode) ---
ATS_REDIS_URL=redis://localhost:6380/0

# --- Workers (arq) ---
ATS_REDIS_JOB_TIMEOUT=300
ATS_REDIS_SHUTDOWN_TIMEOUT=30

# --- Logging (JUGO-032) ---
ATS_LOG_LEVEL=INFO
ATS_LOG_JSON_FORMAT=true
ATS_LOG_MASK_PII=true

# --- Tracing / OpenTelemetry (JUGO-030) ---
# Включить экспорт трейсов в Jaeger/Tempo (false = no-op, для dev/stub)
ATS_OTEL_ENABLED=false
# Имя сервиса в Jaeger
ATS_OTEL_SERVICE_NAME=ats-core
# Версия сервиса (атрибут ресурса)
ATS_OTEL_SERVICE_VERSION=0.1.0
# Endpoint OTLP (Jaeger/Tempo; в docker-compose — http://jaeger:4317)
ATS_OTEL_OTLP_ENDPOINT=http://jaeger:4317
# Протокол OTLP: grpc или http/protobuf
ATS_OTEL_OTLP_PROTOCOL=grpc
# Доп. атрибуты ресурса: key=val,key=val
ATS_OTEL_RESOURCE_ATTRIBUTES=
# Стратегия сэмплинга: always_on, traceidratio, parentbased_always_on, parentbased_traceidratio
ATS_OTEL_TRACES_SAMPLER=parentbased_always_on
# Аргумент сэмплера (напр. ratio=0.1 для traceidratio)
ATS_OTEL_TRACES_SAMPLER_ARG=
# Прокидывать trace_context в воркеры (W3C traceparent)
ATS_OTEL_PROPAGATE_TO_WORKERS=true

# --- Metrics / Prometheus (JUGO-031) ---
# Включить сбор метрик (false = no-op, если prometheus_client не установлен)
ATS_METRICS_ENABLED=true
# Путь endpoint'а для scrape
ATS_METRICS_PATH=/metrics
# Включать handler в метрики (false = только агрегаты)
ATS_METRICS_INCLUDE_ENDPOINTS=true
# Группировать по HTTP status code (2xx/4xx/5xx)
ATS_METRICS_GROUP_STATUS_CODES=true
# Buckets для histogram латентностей (секунды)
ATS_METRICS_LATENCY_BUCKETS=0.005,0.01,0.025,0.05,0.1,0.25,0.5,1,2.5,5,10

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ats-jugo.dev/contracts/events/application.rejected.v1.schema.json",
  "title": "ApplicationRejected v1",
  "description": "Отклик отклонён с официальной причиной из справочника. Дополнительные свойства допустимы (§4.3).",
  "type": "object",
  "required": ["application_id", "reason_code"],
  "properties": {
    "application_id": {"type": "string", "format": "uuid"},
    "candidate_id": {"type": "string", "format": "uuid"},
    "vacancy_id": {"type": "string", "format": "uuid"},
    "reason_code": {"type": "string", "description": "Код причины отказа из справочника."},
    "reason_label": {"type": ["string", "null"], "description": "Человекочитаемая официальная причина."}
  }
}

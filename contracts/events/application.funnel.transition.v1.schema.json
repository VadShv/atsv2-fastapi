{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ats-jugo.dev/contracts/events/application.funnel.transition.v1.schema.json",
  "title": "ApplicationFunnelTransition v1",
  "description": "Переход отклика между стадиями воронки (семантическое событие перехода, JUGO-132). Дополнительные свойства допустимы (§4.3).",
  "type": "object",
  "required": ["application_id", "to_stage_id"],
  "properties": {
    "application_id": {"type": "string", "format": "uuid"},
    "from_stage_id": {"type": ["string", "null"], "description": "Исходная стадия (id); null при первичном размещении."},
    "to_stage_id": {"type": "string", "description": "Стадия назначения (id)."},
    "vacancy_id": {"type": ["string", "null"]},
    "candidate_id": {"type": ["string", "null"]},
    "reason": {"type": ["string", "null"]},
    "actor_type": {"type": ["string", "null"]}
  }
}
